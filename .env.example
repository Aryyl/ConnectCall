# ConnectCall Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real credentials to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ZEGOCLOUD Configuration
# Get these from: https://console.zegocloud.com/ → Your Project → Basic Info
ZEGO_APP_ID=YOUR_ZEGO_APP_ID_HERE
ZEGO_APP_SIGN=YOUR_ZEGO_APP_SIGN_HERE

# Note: Firebase configuration is handled via lib/firebase_options.dart,
# which is generated by FlutterFire CLI and should NOT be committed to public
# repositories. Add it to .gitignore if your repo is public.
